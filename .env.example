# NanoClaw — Community Intelligence Bot
# Copy to .env and fill in values

# ── Required ──────────────────────────────────────────────────

# Anthropic API key (for Claude inside containers)
ANTHROPIC_API_KEY=

# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# ── Memory (Mem0 cloud) ──────────────────────────────────────

# Mem0 API key (from mem0.ai dashboard)
MEM0_API_KEY=

# ── Constitution sync ────────────────────────────────────────

# Platform API URL
EMERGENTVIBE_API_URL=https://emergentvibe.com

# Bot secret for member registration API
BOT_API_SECRET=

# Groups to sync (JSON array)
GROUPS_CONFIG=[]

# ── Self-hosted Memory (recommended for community deployment) ─

# Self-hosted Mem0 SSE URL (overrides MEM0_API_KEY if set)
# Run: docker compose -f docker-compose.mem0.yml up -d
# Then set: MEM0_SSE_URL=http://localhost:8765/sse
# MEM0_SSE_URL=

# OpenAI API key (required by OpenMemory for embeddings)
# OPENAI_API_KEY=

# ── Admin Monitoring ─────────────────────────────────────────

# Telegram user IDs of admins (comma-separated for multi-admin)
# Receives escalation alerts, error DMs, /admin-* commands
# Get your ID by messaging @userinfobot on Telegram
# If unset: /admin-* commands are disabled, no escalation alerts are sent
# ADMIN_TELEGRAM_ID=123456789,987654321

# ── Admin HTTP (kill switch) ──────────────────────────────────

# Bearer token for the admin HTTP endpoint (required to enable it)
# Generate one: openssl rand -hex 32
# ADMIN_HTTP_TOKEN=

# Port for admin HTTP server (default: 3002)
# ADMIN_HTTP_PORT=3002

# ── Axiom Logging ────────────────────────────────────────────

# Axiom API token (free tier: 500GB/mo). Enables structured log shipping.
# AXIOM_TOKEN=

# Axiom dataset name (default: nanoclaw)
# AXIOM_DATASET=nanoclaw

# ── Rota (Kitchen Shifts) ─────────────────────────────────────

# Forum topic ID for the Kitchen Shifts topic (where cover requests + claims are posted)
# Get by creating the topic in your Telegram forum group, then check the thread_id in logs
# ROTA_SHIFTS_TOPIC_ID=

# JID of the main group (for posting rota announcements)
# Format: tg:-100XXXXXXXXXX
# ROTA_GROUP_JID=

# ── Optional ──────────────────────────────────────────────────

# Bot name (default: Andy)
# ASSISTANT_NAME=Andy

# Max concurrent containers (default: 10)
# MAX_CONCURRENT_CONTAINERS=10

# Container memory limit (default: 2g)
# CONTAINER_MEMORY_LIMIT=2g

# Constitution sync interval in ms (default: 300000 = 5 minutes)
# SYNC_INTERVAL_MS=300000

# ── Cost Optimization ────────────────────────────────────────

# Poll interval in ms (default: 30000 = 30s). Lower = more responsive but more API calls.
# POLL_INTERVAL=30000

# Model for group chats (default: SDK default / Sonnet)
# GROUP_MODEL=claude-haiku-4-5-20251001

# Model for DM chats (default: SDK default / Sonnet)
# DM_MODEL=

# Background memory extraction interval (ms, default: 300000 = 5min)
# EXTRACTION_INTERVAL=300000
# Sliding context window for extraction (ms, default: 3600000 = 60min)
# EXTRACTION_WINDOW=3600000
